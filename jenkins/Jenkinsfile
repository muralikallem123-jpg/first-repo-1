pipeline {
    agent any

    tools {
        nodejs 'NodeJS-18'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        CI = 'true'
        NODE_OPTIONS = '--openssl-legacy-provider'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git rev-parse --short HEAD'
            }
        }

        stage('Backend: Maven verify') {
            steps {
                dir('springboot-backend') {
                    sh 'java -version'
                    sh 'bash mvnw -B clean verify'
                }
            }
        }

        stage('Backend: SonarQube scan') {
            steps {
                dir('springboot-backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'bash mvnw -B sonar:sonar -Dsonar.projectKey=employee-backend -Dsonar.sources=src/main/java -Dsonar.java.binaries=target/classes'
                    }
                }
            }
        }

        stage('Frontend: test and build') {
            steps {
                dir('frontend') {
                    sh 'node --version'
                    sh 'npm --version'
                    sh 'npm ci --legacy-peer-deps'
                    sh 'npm test -- --watchAll=false --passWithNoTests'
                    sh 'CI=false npm run build'
                }
            }
        }

        stage('Frontend: SonarQube scan') {
            steps {
                dir('frontend') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        withSonarQubeEnv('SonarQube') {
                            sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=employee-frontend -Dsonar.sources=src"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Both applications passed the initial CI build.'
        }
        failure {
            echo 'Build failed. Review the first failing stage before adding more pipeline steps.'
        }
    }
}